# Allow small models, ignore large models EXCEPT those explicitly tracked
# Note: We will git add the explicitly required models so they bypass this ignore
backend/*.h5
backend/*.keras
backend/*.joblib

# But force inclusion of needed models
!backend/cnn_parkinson_model_refined.keras
!backend/parkinson_disease_detection.h5
!backend/spiral_model_fixed.keras

# General
.DS_Store
Thumbs.db

# Node/Vite
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache
frontend/coverage/

# Python/Flask
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.venv/
backend/venv/
backend/env/
backend/flask_session/

# Data and Logs
backend/*.sqlite3
backend/db.sqlite3
*.log

# Environment variables
.env
.env.local
.env.*.local

# Ignore ALL compiled model files (too large / version-sensitive)
backend/*.h5
backend/*.keras
backend/*.joblib

# Allow ONLY the version-agnostic numpy weight dumps
!backend/voice_weights.npz
!backend/orig_weights.npz
!backend/vgg_weights.npz

# Allow model architecture JSON configs (needed to rebuild spiral models)
!backend/orig_config.json
!backend/vgg_config.json

# Ignore helper/conversion scripts
backend/resave_models.py
backend/extract_weights.py

# Ignore ALL model files by default
backend/*.h5
backend/*.keras
backend/*.joblib

# Allow ONLY the re-saved cross-version compatible models
!backend/model_voice.h5
!backend/model_orig.h5
!backend/model_vgg.h5

# Ignore the conversion script and temp files
backend/resave_models.py
